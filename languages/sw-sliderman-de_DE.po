#: src/Infrastructure/Updates/UpdateProvider.php:53
msgid "Manual updates only"
msgstr "Nur manuelle Aktualisierung"

#: src/Infrastructure/Updates/UpdateProvider.php:71
msgid "GitHub installation requires a manual WordPress admin action."
msgstr "GitHub-Installation nur manuell im WordPress-Backend erlaubt."

#: src/Infrastructure/Updates/UpdateProvider.php:74
msgid "Automatic GitHub installation is blocked."
msgstr "Automatische GitHub-Installation ist gesperrt."

#: src/Infrastructure/Updates/UpdateProvider.php:91
msgid "A valid manual WordPress update action is required."
msgstr "Kein gültiger manueller WordPress-Updateauftrag."

#: src/Infrastructure/Updates/UpdateProvider.php:185
msgid "Signed GitHub release. Install manually through WordPress."
msgstr "Signiertes GitHub-Release. Installation nur manuell über WordPress."

#: src/Infrastructure/Updates/UpdateProvider.php:213
msgid "Checking signed releases …"
msgstr "Signierte Releases werden geprüft …"

#: src/Infrastructure/Updates/UpdateProvider.php:214
msgid "Update check completed."
msgstr "Update-Prüfung abgeschlossen."

#: src/Infrastructure/Updates/UpdateProvider.php:215
msgid "GitHub could not be reached. Try again later."
msgstr "GitHub konnte nicht erreicht werden. Bitte später erneut prüfen."

#: src/Infrastructure/Updates/UpdateProvider.php:241
msgid "Check for updates now"
msgstr "Jetzt auf Updates prüfen"

#: src/Infrastructure/Updates/UpdateProvider.php:243
