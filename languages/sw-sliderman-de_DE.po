#: src/Rest/Errors.php:34
msgid "The slider was changed elsewhere. Reload it or export your changes."
msgstr "Der Slider wurde an anderer Stelle geändert. Neu laden oder die eigenen Änderungen exportieren."

#: src/Rest/Errors.php:44
msgid "The slider contains invalid or missing data."
msgstr "Der Slider enthält ungültige oder fehlende Daten."

#: src/Rest/Errors.php:52
msgid "The slider does not exist."
msgstr "Der Slider existiert nicht."

#: src/Rest/Errors.php:55
msgid "The changes could not be stored. The last published version was not changed."
msgstr "Die Änderungen konnten nicht gespeichert werden. Die letzte veröffentlichte Version wurde nicht verändert."

#: src/Rest/Errors.php:59
msgid "The slider is being saved by another request. Please try again."
msgstr "Der Slider wird gerade von einer anderen Anfrage gespeichert. Bitte erneut versuchen."

#: src/Rest/Errors.php:69
msgid "An unexpected error occurred."
msgstr "Ein unerwarteter Fehler ist aufgetreten."

#: src/Rest/Errors.php:79
msgid "The file is not a supported static WOFF2 font."
msgstr "Die Datei ist keine unterstützte statische WOFF2-Schrift."

#: src/Rest/Errors.php:80
msgid "The font installation could not be stored. Existing installations were not changed."
msgstr "Die Schriftinstallation konnte nicht gespeichert werden. Bestehende Installationen wurden nicht geändert."

#: src/Rest/Errors.php:81
msgid "The local font files could not be written or verified."
msgstr "Die lokalen Schriftdateien konnten nicht geschrieben oder geprüft werden."

#: src/Rest/Errors.php:82
msgid "Font use could not be checked because stored slider data is damaged or unsupported."
msgstr "Die Schriftverwendung konnte wegen beschädigter oder nicht unterstützter Slider-Daten nicht geprüft werden."

#: src/Rest/Errors.php:83
msgid "The catalog response could not be verified. The previous catalog remains active."
msgstr "Die Katalogantwort konnte nicht geprüft werden. Der bisherige Katalog bleibt aktiv."

#: src/Rest/Errors.php:84
msgid "Font management permission is no longer available."
msgstr "Die Berechtigung zur Schriftverwaltung ist nicht mehr vorhanden."

#: src/Rest/Errors.php:85
msgid "The font job does not exist."
msgstr "Der Schriftauftrag existiert nicht."

#: src/Rest/Errors.php:86
msgid "Too many font jobs are active. Wait for a job to finish."
msgstr "Zu viele Schriftaufträge sind aktiv. Den Abschluss eines Auftrags abwarten."

#: src/Rest/Errors.php:87
msgid "The font job exceeded its time limit. Existing installations remain available."
msgstr "Der Schriftauftrag hat sein Zeitlimit überschritten. Bestehende Installationen bleiben verfügbar."

#: src/Rest/Errors.php:88
msgid "The font job could not be scheduled."
msgstr "Der Schriftauftrag konnte nicht eingeplant werden."

#: src/Rest/Errors.php:90
#: src/Rest/FontController.php:129
msgid "The font selection is invalid."
msgstr "Die Schriftauswahl ist ungültig."

#: src/Rest/Errors.php:91
msgid "The font family is not in the local catalog."
msgstr "Die Schriftfamilie ist nicht im lokalen Katalog enthalten."

#: src/Rest/Errors.php:92
msgid "The font installation does not exist."
msgstr "Die Schriftinstallation existiert nicht."

#: src/Rest/Errors.php:93
msgid "A selected style or weight is not available for this family."
msgstr "Ein gewählter Schnitt ist für diese Familie nicht verfügbar."

#: src/Rest/Errors.php:94
msgid "A selected character set is not available for this family."
msgstr "Ein gewählter Zeichensatz ist für diese Familie nicht verfügbar."

#: src/Rest/Errors.php:95
msgid "This family is only available as a variable font, which is not supported yet."
msgstr "Diese Familie ist nur als variable Schrift verfügbar; das wird noch nicht unterstützt."

#: src/Rest/Errors.php:96
msgid "Font downloads are disabled (offline mode)."
msgstr "Font-Downloads sind deaktiviert (Offline-Modus)."

#: src/Rest/Errors.php:97
msgid "This family is already being installed."
msgstr "Diese Familie wird bereits installiert."

#: src/Rest/Errors.php:98
msgid "The font is still used by a slider, a revision or a published version."
msgstr "Die Schrift wird noch von einem Slider, einer Revision oder einem veröffentlichten Stand verwendet."

#: src/Rest/Errors.php:99
msgid "The license of this family could not be verified."
msgstr "Die Lizenz dieser Familie konnte nicht geprüft werden."

#: src/Rest/Errors.php:101
msgid "The font could not be downloaded or verified. Existing installations were not changed."
msgstr "Die Schrift konnte nicht heruntergeladen oder geprüft werden. Bestehende Installationen wurden nicht verändert."

#: src/Rest/FontManagementController.php:95
msgid "The font file is too large."
msgstr "Die Schriftdatei ist zu groß."

#: src/Rest/JsonBody.php:29
msgid "The slider is too large."
msgstr "Der Slider ist zu groß."

#: src/Rest/JsonBody.php:33
msgid "The request body is not a JSON object."
msgstr "Der Anfrageinhalt ist kein JSON-Objekt."

#: src/Rest/JsonBody.php:41
msgid "The title must be text."
msgstr "Der Titel muss Text sein."

#: src/Rest/JsonBody.php:45
msgid "Please enter a name with at most 200 characters."
msgstr "Bitte einen Namen mit höchstens 200 Zeichen eingeben."

#: src/Rest/JsonBody.php:53
msgid "The version is missing or invalid."
msgstr "Die Version fehlt oder ist ungültig."

#. translators: 1: required PHP version, 2: current PHP version
#: sw-sliderman.php:34
#, php-format
msgid "SW Sliderman requires PHP %1$s or newer. You are running PHP %2$s."
msgstr "SW Sliderman benötigt PHP %1$s oder neuer. Installiert ist PHP %2$s."

#: sw-sliderman.php:53
msgid "SW Sliderman: the vendor directory is missing. Install the release package or run \"composer install\"."
msgstr "SW Sliderman: Das vendor-Verzeichnis fehlt. Das Release-Paket installieren oder „composer install“ ausführen."
