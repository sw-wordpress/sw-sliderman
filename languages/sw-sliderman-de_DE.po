#. Plugin Name of the plugin
#: sw-sliderman.php
#: src/Admin/AdminPage.php:49
#: src/Rendering/SliderRenderer.php:109
msgid "SW Sliderman"
msgstr "SW Sliderman"

#. Description of the plugin
#: sw-sliderman.php
msgid "Responsive layer slider with a visual editor, container-based mobile layouts and locally hosted Google Fonts."
msgstr "Responsiver Layer-Slider mit visuellem Editor, containerbasierten Mobil-Layouts und lokal gehosteten Google Fonts."

#. Author of the plugin
#: sw-sliderman.php
msgid "sw-wordpress"
msgstr "sw-wordpress"

#: src/Admin/AdminPage.php:50
msgid "Sliderman"
msgstr "Sliderman"

