msgstr "Plugin-Liste neu laden, um verfügbare Updates anzuzeigen"

#: src/Infrastructure/Updates/UpdateProvider.php:251
msgid "Public release key or required extensions missing. GitHub updates are blocked."
msgstr "Öffentlicher Release-Schlüssel oder nötige Erweiterungen fehlen. GitHub-Updates sind gesperrt."

#: src/Infrastructure/Updates/UpdateProvider.php:254
msgid "No successful update check yet."
msgstr "Noch keine erfolgreiche Update-Prüfung."

#. translators: %s: elapsed time since the last successful check.
#: src/Infrastructure/Updates/UpdateProvider.php:257
#, php-format
msgid "Last successful check: %s ago."
msgstr "Letzte erfolgreiche Prüfung: vor %s."

#. translators: %s: elapsed time since the last attempt, including failures.
#: src/Infrastructure/Updates/UpdateProvider.php:261
#, php-format
msgid "Last attempt: %s ago."
msgstr "Letzter Prüfversuch: vor %s."

#: src/Infrastructure/Updates/UpdateService.php:38
msgid "Update checks require an authorized admin session."
msgstr "Update-Prüfung nur in der berechtigten Backend-Sitzung erlaubt."

#: src/Infrastructure/Updates/UpdateService.php:41
msgid "Public release key or Sodium is missing. GitHub updates are blocked."
msgstr "Öffentlicher Release-Schlüssel oder Sodium fehlt. GitHub-Updates sind gesperrt."

#: src/Infrastructure/Updates/UpdateService.php:45
msgid "An update check is already running."
msgstr "Eine Update-Prüfung läuft bereits."

#: src/Infrastructure/Updates/UpdateService.php:50
msgid "The previous update attempt is still within the check interval."
msgstr "Die letzte Update-Prüfung liegt noch innerhalb des Prüfintervalls."

#: src/Infrastructure/Updates/UpdateService.php:56
msgid "Update check lease expired. The result was discarded."
msgstr "Prüfung dauerte zu lange. Ergebnis wurde nicht übernommen."

#: src/Infrastructure/Updates/UpdateService.php:64
msgid "Signed release metadata checked. Install manually through the Plugins screen."
msgstr "Signierte Release-Informationen geprüft. Installation ausschließlich über die Plugin-Verwaltung."

#: src/Infrastructure/Updates/UpdateService.php:66
msgid "Invalid release response."
msgstr "Ungültige Release-Antwort."

#: src/Infrastructure/Updates/UpdateService.php:87
msgid "No valid stable release was returned."
msgstr "Keine gültige stabile Release-Antwort."

#: src/Infrastructure/Updates/UpdateService.php:96
msgid "Release manifest or signature is missing."
msgstr "Release-Manifest oder Signatur fehlt."

#: src/Infrastructure/Updates/UpdateService.php:112
msgid "A previously verified newer version cannot be rolled back."
msgstr "Eine bereits geprüfte neuere Version darf nicht zurückgenommen werden."

#: src/Infrastructure/Updates/UpdateService.php:131
msgid "Check for updates again before installing."
msgstr "Bitte vor der Installation die Updates erneut prüfen."

#: src/Infrastructure/Updates/UpdateService.php:137
msgid "Outdated release offer."
msgstr "Veraltetes Release-Angebot."

#: src/Infrastructure/Updates/UpdateService.php:156
msgid "Package, version or system requirements do not match."
msgstr "Paket, Version oder Systemvoraussetzungen stimmen nicht."

#: src/Infrastructure/Updates/UpdateService.php:163
msgid "Temporary update file is unavailable."
msgstr "Temporäre Update-Datei nicht verfügbar."

#: src/Infrastructure/Updates/UpdateTransport.php:21
msgid "Update URL is not allowed."
msgstr "Nicht erlaubte Update-Adresse."

#: src/Infrastructure/Updates/UpdateTransport.php:41
msgid "GitHub could not be reached."
msgstr "GitHub konnte nicht erreicht werden."

#: src/Infrastructure/Updates/UpdateTransport.php:47
msgid "Invalid update redirect."
msgstr "Ungültige Weiterleitung."

#: src/Infrastructure/Updates/UpdateTransport.php:53
msgid "GitHub HTTP response: "
msgstr "GitHub-Antwort: HTTP "

#: src/Infrastructure/Updates/UpdateTransport.php:59
msgid "Update response exceeds the size limit."
msgstr "Update-Antwort überschreitet das Größenlimit."

#: src/Infrastructure/Updates/UpdateTransport.php:63
msgid "Too many update redirects."
msgstr "Zu viele Update-Weiterleitungen."

