#. Plugin Name of the plugin
#: sw-sliderman.php
#: src/Admin/AdminPage.php:51
#: src/Rendering/SliderRenderer.php:123
msgid "SW Sliderman"
msgstr "SW Sliderman"

#. Description of the plugin
#: sw-sliderman.php
msgid "Responsive layer slider with a visual editor, container-based mobile layouts and locally hosted Google Fonts."
msgstr "Responsiver Layer-Slider mit visuellem Editor, containerbasierten Mobil-Layouts und lokal gehosteten Google Fonts."

#. Author of the plugin
#: sw-sliderman.php
msgid "Stefan Warnat"
msgstr "Stefan Warnat"

#. Author URI of the plugin
#: sw-sliderman.php
msgid "https://stefanwarnat.de"
msgstr "https://stefanwarnat.de"

