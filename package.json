{
  "name": "sw-sliderman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SW Sliderman editor (Vue 3 + Quasar, no Quasar CLI), frontend runtime and shared modules",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite --config vite.editor.config.ts",
    "build": "npm run typecheck && npm run build:only",
    "build:only": "vite build --config vite.editor.config.ts && vite build --config vite.runtime.config.ts && vite build --config vite.effects.config.ts && vite build --config vite.gpu.config.ts && vite build --config vite.gpu-modules.config.ts && node bin/build-block.mjs && node bin/check-bundles.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "i18n:check": "node bin/i18n-js.mjs check",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-bold": "3.32.2",
    "@tiptap/extension-document": "3.32.2",
    "@tiptap/extension-hard-break": "3.32.2",
    "@tiptap/extension-italic": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-text": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/vue-3": "3.32.2",
    "pinia": "^3.0.0",
    "quasar": "^2.18.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@quasar/vite-plugin": "1.9.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "playwright-core": "1.64.1",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.3.14"
  }
}
