{
  "type": "particle-field",
  "label": "Partikelfeld",
  "description": "GPU-simulierte Partikel: Formen, Strömungen, Wirbel, Zeigerkräfte.",
  "category": "particles",
  "schemaVersion": 1,
  "continuous": true,
  "module": "particle-field.js",
  "schema": {
    "type": "object",
    "properties": {
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200000,
        "default": 20000
      },
      "spawn": {
        "type": "object",
        "properties": {
          "shape": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "point",
              "disc",
              "ring",
              "sphere-surface",
              "sphere-volume",
              "box",
              "line"
            ],
            "default": "sphere-volume"
          },
          "radius": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 50,
            "default": 1.2
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 100
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              2,
              2,
              2
            ]
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -50,
              "maximum": 50
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              0,
              0,
              0
            ]
          },
          "velocity": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "maxLength": 24,
                "enum": [
                  "none",
                  "radial",
                  "tangential",
                  "random"
                ],
                "default": "none"
              },
              "speed": {
                "type": "number",
                "minimum": 0,
                "maximum": 20,
                "default": 0
              }
            }
          }
        }
      },
      "lifecycle": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "persistent",
              "emitter"
            ],
            "default": "persistent"
          },
          "minSeconds": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 60,
            "default": 2
          },
          "maxSeconds": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 60,
            "default": 6
          }
        }
      },
      "operators": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "drag"
                },
                "amount": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10,
                  "default": 0.4,
                  "x-unit": "1/s"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "spring-home"
                },
                "stiffness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 50,
                  "default": 2
                },
                "damping": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10,
                  "default": 0.6
                },
                "maxForce": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 200,
                  "default": 30
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "vortex"
                },
                "axis": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    0,
                    1,
                    0
                  ]
                },
                "center": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -50,
                    "maximum": 50
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    0,
                    0,
                    0
                  ]
                },
                "strength": {
                  "type": "number",
                  "minimum": -20,
                  "maximum": 20,
                  "default": 1
                },
                "pull": {
                  "type": "number",
                  "minimum": -20,
                  "maximum": 20,
                  "default": 0.2
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "flow-field"
                },
                "frequency": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 10,
                  "default": 0.8
                },
                "amplitude": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20,
                  "default": 1
                },
                "speed": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5,
                  "default": 0.3
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "gravity-wells"
                },
                "wells": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "properties": {
                      "position": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": -50,
                          "maximum": 50
                        },
                        "minItems": 3,
                        "maxItems": 3,
                        "default": [
                          0,
                          0,
                          0
                        ]
                      },
                      "mass": {
                        "type": "number",
                        "minimum": -50,
                        "maximum": 50,
                        "default": 1
                      }
                    },
                    "required": [
                      "position",
                      "mass"
                    ]
                  },
                  "default": []
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "speed-limit"
                },
                "max": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 50,
                  "default": 6
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "bounds"
                },
                "mode": {
                  "type": "string",
                  "maxLength": 24,
                  "enum": [
                    "wrap",
                    "bounce",
                    "respawn"
                  ],
                  "default": "wrap"
                },
                "radius": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 100,
                  "default": 4
                }
              },
              "required": [
                "type"
              ]
            }
          ],
          "discriminator": "type"
        },
        "default": []
      },
      "appearance": {
        "type": "object",
        "properties": {
          "style": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "soft-disc",
              "glow",
              "pixel"
            ],
            "default": "soft-disc"
          },
          "sizeMin": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 64,
            "default": 1.5
          },
          "sizeMax": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 64,
            "default": 3.5
          },
          "colorMode": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "solid",
              "speed",
              "life",
              "palette",
              "image"
            ],
            "default": "solid"
          },
          "color": {
            "type": "string",
            "maxLength": 7,
            "format": "color",
            "default": "#78b9ff"
          },
          "color2": {
            "type": "string",
            "maxLength": 7,
            "format": "color",
            "default": "#ffffff"
          },
          "palette": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "maxLength": 7,
              "format": "color",
              "default": "#ffffff"
            },
            "default": [
              "#78b9ff",
              "#ffffff"
            ]
          },
          "blend": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "additive",
              "normal"
            ],
            "default": "additive"
          },
          "opacity": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1,
            "default": 0.8
          },
          "depthFade": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.3
          }
        }
      },
      "camera": {
        "type": "object",
        "properties": {
          "projection": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "perspective",
              "orthographic"
            ],
            "default": "perspective"
          },
          "distance": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "default": 5.5
          },
          "fov": {
            "type": "number",
            "minimum": 10,
            "maximum": 120,
            "default": 50
          },
          "orbitSpeed": {
            "type": "number",
            "minimum": -2,
            "maximum": 2,
            "default": 0
          },
          "tilt": {
            "type": "number",
            "minimum": -1.5,
            "maximum": 1.5,
            "default": 0
          }
        }
      },
      "interaction": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "none",
              "repel",
              "attract",
              "swirl"
            ],
            "default": "none"
          },
          "radius": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 10,
            "default": 0.8
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 50,
            "default": 4
          }
        }
      }
    },
    "required": [
      "count"
    ]
  },
  "presets": [
    {
