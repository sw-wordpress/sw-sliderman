{
  "type": "particle-field",
  "label": "Particle field",
  "description": "GPU-simulated particles: shapes, flows, vortices and pointer forces; can rebuild a picture.",
  "category": "particles",
  "schemaVersion": 1,
  "continuous": true,
  "module": "particle-field.js",
  "schema": {
    "type": "object",
    "properties": {
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200000,
        "default": 20000,
        "title": "Particle count"
      },
      "spawn": {
        "type": "object",
        "properties": {
          "shape": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "point",
              "disc",
              "ring",
              "sphere-surface",
              "sphere-volume",
              "box",
              "line",
              "view"
            ],
            "default": "view",
            "title": "Shape"
          },
          "radius": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 50,
            "default": 1.2,
            "title": "Radius"
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 100
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              2,
              2,
              2
            ],
            "title": "Size (x, y, z)"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -50,
              "maximum": 50
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              0,
              0,
              0
            ],
            "title": "Position (x, y, z)"
          },
          "velocity": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "maxLength": 24,
                "enum": [
                  "none",
                  "radial",
                  "tangential",
                  "random"
                ],
                "default": "none",
                "title": "Direction"
              },
              "speed": {
                "type": "number",
                "minimum": 0,
                "maximum": 20,
                "default": 0,
                "title": "Speed"
              }
            },
            "title": "Initial velocity"
          },
          "coverage": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 2,
            "default": 1,
            "title": "Coverage of the area"
          }
        },
        "title": "Spawn"
      },
      "lifecycle": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "persistent",
              "emitter"
            ],
            "default": "persistent",
            "title": "Mode"
          },
          "minSeconds": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 60,
            "default": 2,
            "title": "Shortest life (s)"
          },
          "maxSeconds": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 60,
            "default": 6,
            "title": "Longest life (s)"
          }
        },
        "title": "Lifecycle"
      },
      "operators": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "drag"
                },
                "amount": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10,
                  "default": 0.4,
                  "x-unit": "1/s",
                  "title": "Amount"
                }
              },
              "required": [
                "type"
              ],
              "title": "Drag"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "spring-home"
                },
                "stiffness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 50,
                  "default": 2,
                  "title": "Stiffness"
                },
                "damping": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10,
                  "default": 0.6,
                  "title": "Damping"
                },
                "maxForce": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 200,
                  "default": 30,
                  "title": "Maximum force"
                }
              },
              "required": [
                "type"
              ],
              "title": "Return to origin"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "vortex"
                },
                "axis": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    0,
                    1,
                    0
                  ],
                  "title": "Axis (x, y, z)"
                },
                "center": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -50,
                    "maximum": 50
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    0,
                    0,
                    0
                  ],
                  "title": "Centre (x, y, z)"
                },
                "strength": {
                  "type": "number",
                  "minimum": -20,
                  "maximum": 20,
                  "default": 1,
                  "title": "Swirl"
                },
                "pull": {
                  "type": "number",
                  "minimum": -20,
                  "maximum": 20,
                  "default": 0.2,
                  "title": "Pull to axis"
                }
              },
              "required": [
                "type"
              ],
              "title": "Vortex"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "flow-field"
                },
                "frequency": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 10,
                  "default": 0.8,
                  "title": "Detail"
                },
                "amplitude": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20,
                  "default": 1,
                  "title": "Strength"
                },
                "speed": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5,
                  "default": 0.3,
                  "title": "Change speed"
                }
              },
              "required": [
                "type"
              ],
              "title": "Flow field"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "gravity-wells"
                },
                "wells": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "properties": {
                      "position": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": -50,
                          "maximum": 50
                        },
                        "minItems": 3,
                        "maxItems": 3,
                        "default": [
                          0,
                          0,
                          0
                        ],
                        "title": "Position (x, y, z)"
                      },
                      "mass": {
                        "type": "number",
                        "minimum": -50,
                        "maximum": 50,
                        "default": 1,
                        "title": "Mass (negative repels)"
                      }
                    },
                    "required": [
                      "position",
                      "mass"
                    ]
                  },
                  "default": [],
                  "title": "Wells"
                }
              },
              "required": [
                "type"
              ],
              "title": "Gravity wells"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "speed-limit"
                },
                "max": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 50,
                  "default": 6,
                  "title": "Maximum speed"
                }
              },
              "required": [
                "type"
              ],
              "title": "Speed limit"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "const": "bounds"
                },
                "mode": {
                  "type": "string",
                  "maxLength": 24,
                  "enum": [
                    "wrap",
                    "bounce",
                    "respawn"
                  ],
                  "default": "wrap",
                  "title": "When leaving"
                },
                "radius": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 100,
                  "default": 4,
                  "title": "Radius"
                }
              },
              "required": [
                "type"
              ],
              "title": "Boundary"
            }
          ],
          "discriminator": "type"
        },
        "default": [],
        "title": "Forces and behaviour"
      },
      "appearance": {
        "type": "object",
        "properties": {
          "style": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "soft-disc",
              "glow",
              "pixel"
            ],
            "default": "soft-disc",
            "title": "Style"
          },
          "sizeMin": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 64,
            "default": 1.5,
            "title": "Smallest size (px)"
          },
          "sizeMax": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 64,
            "default": 3.5,
            "title": "Largest size (px)"
          },
          "colorMode": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "solid",
              "speed",
              "life",
              "palette",
              "image"
            ],
            "default": "solid",
            "title": "Colour from"
          },
          "color": {
            "type": "string",
            "maxLength": 7,
            "format": "color",
            "default": "#78b9ff",
            "title": "Colour"
          },
          "color2": {
            "type": "string",
            "maxLength": 7,
            "format": "color",
            "default": "#ffffff",
            "title": "Second colour"
          },
          "palette": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "maxLength": 7,
              "format": "color",
              "default": "#ffffff"
            },
            "default": [
              "#78b9ff",
              "#ffffff"
            ],
            "title": "Palette"
          },
          "blend": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "additive",
              "normal"
            ],
            "default": "additive",
            "title": "Blending"
          },
          "opacity": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1,
            "default": 0.8,
            "title": "Opacity"
          },
          "depthFade": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.3,
            "title": "Depth fade"
          }
        },
        "title": "Appearance"
      },
      "camera": {
        "type": "object",
        "properties": {
          "projection": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "perspective",
              "orthographic"
            ],
            "default": "perspective",
            "title": "Projection"
          },
          "distance": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "default": 5.5,
            "title": "Distance"
          },
          "fov": {
            "type": "number",
            "minimum": 10,
            "maximum": 120,
            "default": 50,
            "title": "Field of view (°)"
          },
          "orbitSpeed": {
            "type": "number",
            "minimum": -2,
            "maximum": 2,
            "default": 0,
            "title": "Orbit speed (rad/s)"
          },
          "tilt": {
            "type": "number",
            "minimum": -1.5,
            "maximum": 1.5,
            "default": 0,
            "title": "Tilt (rad)"
          }
        },
        "title": "Camera"
      },
      "interaction": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "none",
              "repel",
              "attract",
              "swirl",
              "magnet"
            ],
            "default": "none",
            "title": "Pointer effect"
          },
          "radius": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 10,
            "default": 0.8,
            "title": "Radius"
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 200,
            "default": 4,
            "title": "Strength"
          },
          "polarity": {
            "type": "number",
            "minimum": -1,
            "maximum": 1,
            "default": 1,
            "title": "Polarity"
          },
          "speedBoost": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "default": 2,
            "title": "Movement boost"
          }
        },
        "title": "Pointer"
      },
      "image": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "title": "Rebuild the image from particles"
          },
          "fit": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "contain",
              "cover"
            ],
            "default": "contain",
            "title": "Fit"
          },
          "scale": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 2,
            "default": 0.9,
            "title": "Scale"
          },
          "sampling": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "uniform",
              "luminance",
              "inverse-luminance"
            ],
            "default": "uniform",
            "title": "Distribution"
          },
          "depth": {
            "type": "number",
            "minimum": 0,
            "maximum": 3,
            "default": 0,
            "title": "Relief depth"
          },
          "assemble": {
            "type": "string",
            "maxLength": 24,
            "enum": [
              "rest",
              "scatter"
            ],
            "default": "rest",
            "title": "Start"
          },
          "colorBoost": {
            "type": "number",
            "minimum": 0,
            "maximum": 3,
            "default": 1,
            "title": "Colour boost"
          }
        },
        "title": "Image"
      }
    },
    "required": [
      "count"
    ]
  },
