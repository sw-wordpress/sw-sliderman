            ],
            "strength": 1.4,
            "pull": 0.0
          },
          {
            "type": "drag",
            "amount": 0.2
          }
        ],
        "appearance": {
          "style": "soft-disc",
          "sizeMin": 1.2,
          "sizeMax": 3,
          "color": "#78b9ff",
          "color2": "#ffffff",
          "colorMode": "speed",
          "opacity": 0.7
        },
        "camera": {
          "orbitSpeed": 0.12,
