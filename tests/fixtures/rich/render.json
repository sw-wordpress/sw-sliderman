{
    "description": "Rich text HTML golden (html generated by bin/contract-fixtures.php from the PHP implementation, reviewed by hand).",
    "cases": [
        {
            "name": "plain paragraph",
            "rich": [
                {
                    "runs": [
                        {
                            "text": "Hallo Welt"
                        }
                    ]
                }
            ],
            "html": "<span class=\"sws-p\">Hallo Welt</span>"
        },
        {
            "name": "marks nest as link > strong > em",
            "rich": [
                {
                    "runs": [
                        {
                            "text": "x",
                            "bold": true,
                            "italic": true,
                            "link": {
                                "url": "https://example.com/a?x=1&y=2",
                                "newTab": true
                            }
                        }
                    ]
                }
            ],
            "html": "<span class=\"sws-p\"><a href=\"https://example.com/a?x=1&amp;y=2\" target=\"_blank\" rel=\"noopener noreferrer\"><strong><em>x</em></strong></a></span>"
        },
        {
            "name": "escaping of markup, quotes and entities",
            "rich": [
                {
                    "runs": [
                        {
                            "text": "<script>alert(\"x\")</script> & &amp; 'q'"
                        }
                    ]
                }
            ],
            "html": "<span class=\"sws-p\">&lt;script&gt;alert(&quot;x&quot;)&lt;/script&gt; &amp; &amp;amp; &#039;q&#039;</span>"
        },
        {
            "name": "line breaks and an empty paragraph",
            "rich": [
                {
                    "runs": [
                        {
                            "text": "a\nb"
                        },
                        {
                            "text": "c",
                            "bold": true
                        }
                    ]
                },
                {
                    "runs": []
                },
                {
                    "runs": [
                        {
                            "text": "ÄÖÜ € \u2028"
                        }
                    ]
                }
            ],
            "html": "<span class=\"sws-p\">a<br>b<strong>c</strong></span><span class=\"sws-p\"><br></span><span class=\"sws-p\">ÄÖÜ € \u2028</span>"
        },
        {
            "name": "same-tab and relative links",
            "rich": [
                {
                    "runs": [
                        {
                            "text": "intern",
                            "link": {
                                "url": "/kontakt"
                            }
                        },
                        {
                            "text": " mail",
                            "link": {
                                "url": "mailto:a@example.com"
                            }
                        },
                        {
                            "text": " anchor",
                            "italic": true,
                            "link": {
                                "url": "#top"
                            }
                        }
                    ]
                }
            ],
            "html": "<span class=\"sws-p\"><a href=\"/kontakt\">intern</a><a href=\"mailto:a@example.com\"> mail</a><a href=\"#top\"><em> anchor</em></a></span>"
        },
        {
            "name": "unsafe links are rendered as plain text",
            "rich": [
                {
                    "runs": [
                        {
                            "text": "bad",
                            "link": {
                                "url": "javascript:alert(1)"
                            }
                        },
                        {
                            "text": "bad2",
                            "bold": true,
                            "link": {
                                "url": "//evil.example"
                            }
                        },
                        {
                            "text": "quote",
                            "link": {
                                "url": "https://a.example/\"onclick=1"
                            }
                        }
                    ]
                }
            ],
            "html": "<span class=\"sws-p\">bad<strong>bad2</strong>quote</span>"
        }
    ]
}
