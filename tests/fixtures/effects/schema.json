{
  "description": "Shared cases for assets/gpu/core/schema.ts and src/Domain/EffectSchema.php. A value {\"repeat\": s, \"times\": n} expands to s repeated n times. Issues are compared as sets.",
  "schemas": {
    "particle": {
      "type": "object",
      "required": [
        "count",
        "spawn"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "default": 20000
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "default": "Nebel"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "spawn": {
          "type": "object",
          "required": [
            "shape"
          ],
          "properties": {
            "shape": {
              "type": "string",
              "enum": [
                "sphere",
                "ring",
                "disc"
              ],
              "default": "sphere",
              "maxLength": 16
            },
            "radius": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 100,
              "default": 1.2
            },
            "position": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "minItems": 3,
              "maxItems": 3,
              "default": [
                0,
                0,
                0
              ]
            }
          }
        },
        "appearance": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "maxLength": 7,
              "format": "color",
              "default": "#78b9ff"
            },
            "blend": {
              "type": "string",
              "enum": [
                "normal",
                "additive"
              ],
              "default": "additive",
              "maxLength": 16
            },
            "id": {
              "type": "string",
              "maxLength": 64,
              "format": "id"
            }
          }
        },
        "operators": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "strength"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "maxLength": 16,
                    "const": "vortex"
                  },
                  "strength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10
                  },
                  "axis": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "default": [
                      0,
                      0,
                      0
                    ]
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "maxLength": 16,
                    "const": "drag"
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.1
                  }
                }
              }
            ],
            "discriminator": "type"
          },
          "default": []
        }
      }
    }
  },
