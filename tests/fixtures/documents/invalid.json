{
  "description": "Invalid document cases shared by the PHP and TypeScript validators. Each case patches valid/<base>.json (op set|remove at a JSON pointer; a value {\"repeat\": s, \"times\": n} expands to s repeated n times) and lists the exact expected issues (compared as a set).",
  "cases": [
    {
      "name": "newer schema version is rejected without further inspection",
      "base": "basic",
      "ops": [
        {
          "op": "set",
          "path": "/schemaVersion",
          "value": 2
        },
        {
          "op": "remove",
          "path": "/slides"
        }
      ],
      "issues": [
        {
          "path": "/schemaVersion",
          "code": "schema_version"
        }
      ]
    },
    {
      "name": "root must be an object",
      "base": "basic",
      "ops": [
        {
          "op": "set",
          "path": "",
          "value": [
            1,
            2
          ]
        }
      ],
      "issues": [
        {
          "path": "",
          "code": "type"
        }
      ]
    },
    {
      "name": "missing settings",
      "base": "basic",
      "ops": [
        {
          "op": "remove",
          "path": "/settings"
        }
      ],
      "issues": [
        {
          "path": "/settings",
          "code": "required"
        }
      ]
    },
    {
      "name": "unknown root key",
      "base": "basic",
      "ops": [
        {
          "op": "set",
          "path": "/script",
          "value": "alert(1)"
        }
      ],
      "issues": [
        {
          "path": "/script",
          "code": "unknown_key"
        }
      ]
    },
    {
      "name": "settings must be an object, not a list",
      "base": "basic",
      "ops": [
        {
          "op": "set",
          "path": "/settings",
          "value": []
        }
      ],
      "issues": [
        {
          "path": "/settings",
          "code": "type"
        }
      ]
    },
    {
      "name": "boolean required for autoplay",
      "base": "basic",
      "ops": [
        {
          "op": "set",
          "path": "/settings/autoplay",
          "value": "yes"
        }
      ],
      "issues": [
        {
          "path": "/settings/autoplay",
          "code": "type"
        }
      ]
    },
    {
