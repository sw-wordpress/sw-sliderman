      "base": "basic",
      "ops": [
        {
          "op": "set",
          "path": "/breakpoints/desktop/stageWidth",
          "value": 1440.5
        }
      ],
      "issues": [
        {
          "path": "/breakpoints/desktop/stageWidth",
