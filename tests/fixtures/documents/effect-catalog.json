{
  "description": "Effect types known to the validators in the shared contract tests (PHP EffectCatalog / TS EffectCatalog).",
  "particle-field": {
    "schemaVersion": 2,
    "continuous": true,
    "schema": {
      "type": "object",
      "required": ["count"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "default": 20000
        },
        "tint": {
          "type": "string",
          "maxLength": 7,
          "format": "color",
          "default": "#ffffff"
        },
        "mode": {
          "type": "string",
          "maxLength": 16,
          "enum": ["repel", "attract"],
          "default": "repel"
        }
      }
    }
  },
  "acme/glow": {
    "schemaVersion": 1,
    "continuous": false,
    "schema": {
      "type": "object",
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    }
  }
}
